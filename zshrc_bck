# ==============================================================================
# Portable Personal Zsh Configuration (~/zshrc_bck)
# Shared across machines for aliases, portable environment and workflow shortcuts
# ==============================================================================

# --- Environment Variables ---
export CLOUDSDK_PYTHON_SITEPACKAGES=1
export HOMEBREW_NO_PATH_SHADOW_CHECK=1

# --- PATH Additions (only added if the directory actually exists on the machine) ---
[[ -d "$HOME/.local/bin" ]] && export PATH="$HOME/.local/bin:$PATH"
[[ -d "/usr/local/sbin" ]] && export PATH="$PATH:/usr/local/sbin"
[[ -d "/usr/local/opt/mysql-client/bin" ]] && export PATH="/usr/local/opt/mysql-client/bin:$PATH"
[[ -d "$HOME/Library/Python/3.8/bin" ]] && export PATH="$PATH:$HOME/Library/Python/3.8/bin"

# --- Homebrew (Fast & Portable: detects Apple Silicon or Intel without slow brew subshell) ---
if [[ -x /opt/homebrew/bin/brew ]]; then
  export HOMEBREW_PREFIX="/opt/homebrew"
  export HOMEBREW_CELLAR="/opt/homebrew/Cellar"
  export HOMEBREW_REPOSITORY="/opt/homebrew"
  export PATH="/opt/homebrew/bin:/opt/homebrew/sbin${PATH+:$PATH}"
  [ -z "${MANPATH-}" ] || export MANPATH="${MANPATH%"${MANPATH##*[!:]}"}:${MANPATH#"${MANPATH%%[!:]*}"}"
  export INFOPATH="/opt/homebrew/share/info:${INFOPATH:-}"
elif [[ -x /usr/local/bin/brew ]]; then
  export HOMEBREW_PREFIX="/usr/local"
  export HOMEBREW_CELLAR="/usr/local/Cellar"
  export HOMEBREW_REPOSITORY="/usr/local/Homebrew"
  export PATH="/usr/local/bin:/usr/local/sbin${PATH+:$PATH}"
  [ -z "${MANPATH-}" ] || export MANPATH="${MANPATH%"${MANPATH##*[!:]}"}:${MANPATH#"${MANPATH%%[!:]*}"}"
  export INFOPATH="/usr/local/share/info:${INFOPATH:-}"
fi

# --- Personal Aliases ---
alias ll='ls -lh'
alias psgrep='ps aux | grep'
alias speedtest='curl -s https://raw.githubusercontent.com/sivel/speedtest-cli/master/speedtest.py | python3 -'
alias py='python3'
alias python='python3'
alias pip='python3 -m pip'
alias pip3='python3 -m pip'
alias kctl='kubectl'
alias k='kubectl'
alias netstatTCP='sudo lsof -PiTCP -sTCP:LISTEN'
alias vi='vim'
alias gti='git'
alias g='gcloud'
